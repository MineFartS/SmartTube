[submodule "lib/sdk"]
	path = lib/sdk
	url = https://github.com/MineFartsEmbed/Android-SDK
    ignore = dirty

[submodule "lib/jdk17"]
	path = lib/jdk17
	url = https://github.com/MineFartsEmbed/JDK
	branch = 17
    ignore = dirty

[submodule "lib/pidcat"]
	path = lib/pidcat
	url = https://github.com/MineFartS/pidcat
    ignore = dirty

[submodule "lib/py314"]
	path = lib/py314
	url = https://github.com/MineFartsEmbed/Python
    branch = 3.14.5
    ignore = dirty

[submodule "lib/yuliskov"]
	path = lib/yuliskov
	url = https://github.com/yuliskov/SmartTube
    ignore = dirty

